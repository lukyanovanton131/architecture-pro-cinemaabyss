{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "Movies": {
        "ClusterId": "movies",
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "Monolith": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "movies": { 
        "LoadBalancingPolicy": "Percentage",
        "Destinations": {
          "monolith": {
            "Address": "http://monolith:8080"
          },
          "movies-service": {
            "Address": "http://movies-service:8081"
          }
        }
      },
      "monolith": {
        "Destinations": {
          "monolith": {
            "Address": "http://monolith:8080"
          }
        }
      }
    }   
  },
  "GRADUAL_MIGRATION": true,
  "MOVIES_MIGRATION_PERCENT": "50",
  "MOVIES_SERVICE_URL": "http://movies-service:8081",
  "MONOLITH_URL": "http://monolith:8080"
}
